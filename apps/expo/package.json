{
  "name": "@acme/expo",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "clean": "git clean -xdf .cache .expo .turbo android ios node_modules",
    "dev": "expo start -c",
    "dev:android": "expo start --android",
    "dev:ios": "expo start --ios",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "format": "prettier --check . --ignore-path ../../.gitignore --ignore-path .prettierignore",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "build:development": "pnpm dlx eas-cli build --profile development",
    "build:development:ios": "pnpm dlx eas-cli build --profile development --platform ios",
    "build:development:android": "pnpm dlx eas-cli build --profile development --platform android",
    "build:staging": "pnpm dlx eas-cli build --profile staging",
    "build:staging:ios": "pnpm dlx eas-cli build --profile staging --platform ios",
    "build:staging:android": "pnpm dlx eas-cli build --profile staging --platform android",
    "build:production": "pnpm dlx eas-cli build --profile production",
    "build:production:ios": "pnpm dlx eas-cli build --profile production --platform ios",
    "build:production:android": "pnpm dlx eas-cli build --profile production --platform android",
    "submit:development:ios": "pnpm dlx eas-cli submit --profile development --platform ios",
    "submit:development:android": "pnpm dlx eas-cli submit --profile development --platform android",
    "submit:staging:ios": "pnpm dlx eas-cli submit --profile staging --platform ios",
    "submit:staging:android": "pnpm dlx eas-cli submit --profile staging --platform android",
    "submit:production:ios": "pnpm dlx eas-cli submit --profile production --platform ios",
    "submit:production:android": "pnpm dlx eas-cli submit --profile production --platform android"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "@trpc/client",
          "@trpc/server",
          "@trpc/tanstack-react-query",
          "luxon",
          "superjson",
          "react-native-image-zoom-viewer"
        ]
      }
    }
  },
  "dependencies": {
    "@ai-sdk/react": "1.2.12",
    "@expo-google-fonts/inter": "^0.4.1",
    "@expo-google-fonts/lora": "^0.4.1",
    "@expo-google-fonts/playfair-display": "^0.4.2",
    "@expo/metro-config": "^0.20.17",
    "@gorhom/bottom-sheet": "^5.1.6",
    "@howljs/calendar-kit": "^2.2.2",
    "@legendapp/list": "^1.1.4",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/datetimepicker": "^8.4.1",
    "@react-native-masked-view/masked-view": "^0.3.2",
    "@react-navigation/drawer": "^7.3.9",
    "@rn-primitives/avatar": "^1.2.0",
    "@rn-primitives/select": "^1.2.0",
    "@rn-primitives/slot": "^1.2.0",
    "@shopify/flash-list": "^1.7.6",
    "@stardazed/streams-text-encoding": "^1.0.2",
    "@tanstack/react-query": "catalog:",
    "@trpc/client": "catalog:",
    "@trpc/server": "catalog:",
    "@trpc/tanstack-react-query": "catalog:",
    "@ungap/structured-clone": "^1.3.0",
    "ai": "4.3.16",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "expo": "53.0.20",
    "expo-blur": "~14.1.5",
    "expo-constants": "17.1.7",
    "expo-crypto": "^14.1.5",
    "expo-dev-client": "5.2.4",
    "expo-device": "^7.1.4",
    "expo-font": "~13.3.2",
    "expo-image": "^2.4.0",
    "expo-image-picker": "^16.1.4",
    "expo-linear-gradient": "~14.1.5",
    "expo-linking": "7.1.7",
    "expo-local-authentication": "^16.0.5",
    "expo-location": "~18.1.6",
    "expo-notifications": "^0.31.4",
    "expo-router": "5.1.4",
    "expo-secure-store": "14.2.3",
    "expo-splash-screen": "0.30.10",
    "expo-status-bar": "2.2.3",
    "expo-system-ui": "~5.0.10",
    "expo-task-manager": "^13.1.6",
    "expo-video": "^3.0.11",
    "expo-web-browser": "14.2.0",
    "lucide-react-native": "^0.539.0",
    "luxon": "^3.7.1",
    "nativewind": "~4.1.23",
    "phosphor-react-native": "^3.0.0",
    "react": "catalog:react19",
    "react-dom": "catalog:react19",
    "react-native": "0.79.5",
    "react-native-gesture-handler": "~2.24.0",
    "react-native-image-zoom-viewer": "^3.0.1",
    "react-native-markdown-display": "^7.0.2",
    "react-native-modal": "14.0.0-rc.1",
    "react-native-reanimated": "3.17.5",
    "react-native-redash": "^18.1.3",
    "react-native-safe-area-context": "~5.4.0",
    "react-native-screens": "~4.11.1",
    "react-native-svg": "15.11.2",
    "sonner-native": "^0.21.0",
    "superjson": "2.2.2",
    "tailwind-merge": "^3.3.1",
    "zod": "4.0.5",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@acme/api": "workspace:*",
    "@acme/eslint-config": "workspace:*",
    "@acme/prettier-config": "workspace:*",
    "@acme/tailwind-config": "workspace:*",
    "@acme/tsconfig": "workspace:*",
    "@babel/core": "^7.28.0",
    "@babel/preset-env": "^7.28.0",
    "@babel/runtime": "^7.27.6",
    "@types/babel__core": "^7.20.5",
    "@types/luxon": "^3.6.2",
    "@types/react": "^19.0.14",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "react-native-svg-transformer": "^1.5.1",
    "tailwindcss": "catalog:",
    "typescript": "catalog:"
  },
  "prettier": "@acme/prettier-config"
}
